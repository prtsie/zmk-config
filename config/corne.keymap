#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        // Home row mod для ЛЕВОЙ руки: срабатывает как модификатор только
        // если параллельно нажата клавиша ПРАВОЙ руки (positional hold-tap).
        // Это убирает случайные срабатывания при быстром наборе одной рукой.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        // Зеркальный home row mod для ПРАВОЙ руки.
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    // Adjust-слой сам активируется, когда одновременно держите Lower и Raise.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh_layer {
            // Основная раскладка: Colemak-DH + home row mods (GACS) + Caps Word.
            bindings = <
&kp ESC     &kp Q  &kp W       &kp F        &kp P        &kp B       &kp J  &kp L        &kp U        &kp Y        &kp SQT      &kp BSPC
&caps_word  &hml LGUI A  &hml LALT R  &hml LCTRL S  &hml LSHFT T  &kp G       &kp M  &hmr LSHFT N  &hmr LCTRL E  &hmr LALT I  &hmr LGUI O  &kp DEL
&none       &kp Z  &kp X       &kp C        &kp D        &kp V       &kp K  &kp H        &kp COMMA    &kp DOT      &kp FSLH     &none
                    &mt LALT K_APP  &mo 2  &kp SPACE          &kp RET  &mo 3  &mt LGUI CAPS
            >;
        };

        qwerty_layer {
            // Переходная QWERTY (пока не привыкнете к Colemak-DH). Тумблер — см. Adjust-слой.
            bindings = <
&trans  &kp Q  &kp W       &kp E        &kp R        &kp T       &kp Y  &kp U        &kp I        &kp O        &kp P         &trans
&trans  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G       &kp H  &hmr LSHFT J  &hmr LCTRL K  &hmr LALT L  &hmr LGUI SEMI  &trans
&trans  &kp Z  &kp X       &kp C        &kp V        &kp B       &kp N  &kp M        &kp COMMA    &kp DOT      &kp FSLH      &trans
                &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        lower_layer {
            // Цифры, стрелки, управление окнами (закрыть / перенести на монитор / свернуть / развернуть), символы.
            bindings = <
&trans  &kp N1     &kp N2         &kp N3     &kp N4         &kp N5       &kp N6    &kp N7    &kp N8   &kp N9   &kp N0   &trans
&kp LA(F4)  &kp LG(LS(LEFT))  &kp LG(DOWN)  &kp LG(UP)  &kp LG(LS(RIGHT))  &none        &none     &kp LEFT  &kp DOWN &kp UP   &kp RIGHT &none
&trans  &kp MINUS  &kp EQUAL      &kp LBKT   &kp RBKT       &kp BSLH     &kp HOME  &kp PG_DN &kp PG_UP &kp END &none    &trans
                &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        raise_layer {
            // F-клавиши, символы (Shift+цифры), медиа (без RGB — подсветки нет).
            bindings = <
&kp F11  &kp F1  &kp F2   &kp F3   &kp F4   &kp F5    &kp F6   &kp F7   &kp F8    &kp F9   &kp F10  &kp F12
&none    &kp EXCL &kp AT  &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &none
&none    &none   &none    &none    &none    &kp C_MUTE  &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_PP &none
                &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        adjust_layer {
            // Автоматически включается при Lower+Raise. Bluetooth, сброс, тумблер QWERTY-слоя.
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &out OUT_TOG  &none  &none  &none  &none  &bootloader
&none         &none         &none         &none         &none         &tog 1        &none         &none  &none  &none  &none  &sys_reset
&none         &none         &none         &none         &none         &none         &none         &none  &none  &none  &none  &none
                    &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        game_layer {
            // Честный QWERTY без home row mods (важна скорость реакции).
            // TAB (верхний ряд, крайняя левая) + LALT (домашний ряд, прямо под ней) —
            // держите Alt и тапайте Tab сколько нужно, это настоящий системный Alt+Tab с перелистыванием.
            bindings = <
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T       &kp Y  &kp U  &kp I  &kp O  &kp P     &kp BSPC
&kp LALT  &kp A  &kp S  &kp D  &kp F  &kp G       &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp RCTRL
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B       &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                 &mt LALT K_APP  &mo 6  &kp SPACE      &kp RET  &mo 3  &mt LGUI CAPS
            >;
        };

        game_num_layer {
            // Держите thumb-клавишу на игровом слое — верхний ряд превращается в 1234567890 (хотбар).
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5      &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };
    };
};
